---
import { Image } from 'astro:assets'
import SectionHeader from '../components/SectionHeader.astro'
import { openSourceItems } from '../data/opensource'
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE_DESCRIPTION, SITE_TITLE_ZH } from '../consts'

const pageTitle = `Projects — ${SITE_TITLE_ZH}`
---

<BaseLayout title={pageTitle} description={SITE_DESCRIPTION} barbaNamespace="project">
  <style>
    :global(main) {
      width: 100%;
      max-width: none;
      padding: 0;
      margin: 0;
    }
    .project-page {
      padding: calc(var(--nav-height) + var(--space-xl)) 0 var(--space-2xl);
    }
    .container {
      width: min(var(--container-max), calc(100% - 48px));
      margin: 0 auto;
    }
    .project-list {
      display: grid;
      margin-top: var(--space-xl);
    }
    .project-item {
      display: flex;
      align-items: center;
      gap: var(--space-lg);
      padding: var(--space-lg) 0;
      border-bottom: 1px solid var(--border);
      text-decoration: none;
    }
    .project-item:first-child {
      border-top: 1px solid var(--border);
    }
    .project-info {
      flex: 1;
      min-width: 0;
    }
    .project-meta {
      display: flex;
      align-items: center;
      gap: var(--space-md);
      margin-bottom: var(--space-sm);
    }
    .project-number {
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-size: var(--text-caption);
      letter-spacing: var(--ls-number);
    }
    .project-year {
      color: var(--accent);
      font-family: var(--font-display);
      font-size: var(--text-small);
      font-weight: 500;
    }
    .project-title {
      margin-bottom: var(--space-md);
      font-family: var(--font-display);
      font-size: var(--text-h1);
      font-weight: 500;
      line-height: 1.1;
      color: var(--text-primary);
      transition: color 0.2s var(--ease-in-out);
    }
    .project-item:hover .project-title {
      color: var(--accent);
    }
    .project-techs {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xs);
    }
    .project-hover-image {
      flex-shrink: 0;
      width: 280px;
      transition: transform 0.3s var(--ease-out);
    }
    .project-hover-image :global(img) {
      width: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      border-radius: var(--radius-md);
      display: block;
      transition: box-shadow 0.3s var(--ease-out);
    }
    .project-item:hover .project-hover-image {
      transform: translateY(-8px);
    }
    .project-item:hover .project-hover-image :global(img) {
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
    }
    @media (max-width: 768px) {
      .project-item {
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-sm);
      }
      .project-title {
        font-size: var(--text-h2);
      }
      .project-hover-image {
        width: 100%;
      }
    }
  </style>

  <section class="project-page">
    <div class="container">
      <SectionHeader tag="Open Source" title="P R O J E C T S" splitText />
      <div class="project-list">
        {
          openSourceItems.map((item, index) => {
            const num = String(index + 1).padStart(2, '0')
            return (
              <a href={`/project/${item.name}`} class="project-item">
                <div class="project-info">
                  <div class="project-meta">
                    <span class="project-number">( {num} )</span>
                    <span class="project-year">{item.year}</span>
                  </div>
                  <h2 class="project-title">
                    <span>{item.name}</span>
                  </h2>
                  <div class="project-techs">
                    {item.techs.map((tech) => <span class="tech-chip">{tech}</span>)}
                  </div>
                </div>
                <div class="project-hover-image">
                  <Image src={item.image} alt={item.name} widths={[400]} sizes="280px" />
                </div>
              </a>
            )
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>
