---
import SectionHeader from '../components/SectionHeader.astro'
import {
  aboutIntro,
  contactLinks,
  experienceEntries,
  heroContent,
  projectGroups,
  skillGroups,
  strengths
} from '../data/profile'
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE_DESCRIPTION, SITE_TITLE_ZH } from '../consts'

const pageTitle = `About — ${SITE_TITLE_ZH}`
---

<BaseLayout title={pageTitle} description={SITE_DESCRIPTION} barbaNamespace="about">
  <style>
    :global(main) {
      width: 100%;
      max-width: none;
      padding: 0;
      margin: 0;
    }
    .about-section {
      padding: var(--space-2xl) 0;
    }
    .container {
      width: min(var(--container-max), calc(100% - 48px));
      margin: 0 auto;
    }
    /* Intro */
    .about-intro {
      max-width: 900px;
      color: var(--text-secondary);
      font-size: var(--text-h2);
      line-height: 1.6;
    }
    .about-intro :global(strong) {
      color: var(--text-primary);
      font-weight: 700;
    }
    /* Team */
    .team-card {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: center;
      padding: var(--space-xl);
    }
    .team-name {
      margin-bottom: var(--space-sm);
      font-family: var(--font-display);
      font-size: var(--text-hero-lg);
      font-weight: 700;
      line-height: 1.1;
    }
    .team-role {
      margin-bottom: var(--space-md);
      color: var(--accent);
      font-family: var(--font-display);
      font-size: var(--text-h3);
    }
    .team-bio {
      color: var(--text-secondary);
      line-height: 1.8;
    }
    .team-bio :global(strong) {
      color: var(--text-primary);
      font-weight: 700;
    }
    .team-location {
      margin-top: var(--space-md);
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-size: var(--text-small);
    }
    /* Experience */
    .timeline {
      display: grid;
      gap: var(--space-lg);
      margin-bottom: var(--space-2xl);
    }
    .timeline-item {
      padding-bottom: var(--space-md);
      border-bottom: 1px solid var(--border);
    }
    .timeline-period {
      color: var(--accent);
      font-family: var(--font-display);
      font-size: var(--text-small);
      font-weight: 600;
      letter-spacing: var(--ls-tag);
    }
    .timeline-company {
      margin: var(--space-xs) 0;
      font-family: var(--font-display);
      font-size: var(--text-h3);
      font-weight: 600;
    }
    .timeline-role {
      color: var(--text-secondary);
      margin-bottom: var(--space-sm);
    }
    .timeline-list {
      padding-left: 1.2rem;
      color: var(--text-muted);
    }
    .timeline-list li {
      margin-bottom: var(--space-xs);
    }
    .project-group {
      margin-bottom: var(--space-xl);
    }
    .project-group-label {
      margin-bottom: var(--space-md);
      color: var(--text-secondary);
      font-family: var(--font-display);
      font-size: var(--text-h3);
      font-weight: 600;
    }
    .project-grid {
      display: grid;
      gap: var(--space-md);
    }
    .project-card {
      padding: var(--space-md);
    }
    .project-card-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-sm);
      margin-bottom: var(--space-sm);
    }
    .project-card-name {
      font-family: var(--font-display);
      font-size: var(--text-h3);
      font-weight: 600;
    }
    .project-card-period {
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: var(--text-small);
    }
    .project-card-desc {
      color: var(--text-secondary);
      line-height: 1.7;
      margin-bottom: var(--space-sm);
    }
    .project-card-techs {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xs);
      margin-bottom: var(--space-sm);
    }
    .project-card-result {
      color: var(--text-muted);
      font-size: var(--text-small);
      font-weight: 500;
    }
    /* Skills */
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-md);
    }
    .skill-card {
      padding: var(--space-md);
    }
    .skill-card-title {
      margin-bottom: var(--space-md);
      font-family: var(--font-display);
      font-size: var(--text-h3);
      font-weight: 600;
    }
    .skill-items {
      display: grid;
      gap: var(--space-sm);
    }
    .skill-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-sm);
    }
    .skill-name {
      color: var(--text-primary);
    }
    .skill-level {
      padding: 0.2rem 0.65rem;
      border-radius: var(--radius-full);
      font-size: var(--text-caption);
      font-weight: 600;
    }
    .skill-level.expert {
      background: var(--accent-light);
      color: var(--accent);
    }
    .skill-level.proficient {
      background: rgba(59, 130, 246, 0.12);
      color: #3b82f6;
    }
    .skill-level.familiar {
      background: rgba(0, 0, 0, 0.06);
      color: var(--text-muted);
    }
    /* Strengths */
    .strengths-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-md);
    }
    .strength-card {
      padding: var(--space-lg);
      text-align: center;
    }
    .strength-icon {
      font-size: 2.25rem;
      margin-bottom: var(--space-sm);
      display: block;
    }
    .strength-title {
      margin-bottom: var(--space-sm);
      font-family: var(--font-display);
      font-size: var(--text-h3);
      font-weight: 600;
    }
    .strength-desc {
      color: var(--text-secondary);
      font-size: var(--text-small);
      line-height: 1.7;
    }
    /* Contact */
    .contact-links {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }
    .contact-link {
      display: flex;
      align-items: center;
      gap: var(--space-md);
      padding: var(--space-md);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      text-decoration: none;
      transition: border-color 0.2s var(--ease-in-out);
    }
    .contact-link:hover {
      border-color: var(--accent);
    }
    .contact-icon {
      font-size: 1.75rem;
    }
    .contact-label {
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-size: var(--text-caption);
      letter-spacing: var(--ls-tag);
    }
    .contact-value {
      color: var(--text-primary);
      font-weight: 500;
    }
    @media (max-width: 1024px) {
      .skills-grid,
      .strengths-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .team-card {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 768px) {
      .about-intro {
        font-size: var(--text-body);
      }
      .skills-grid,
      .strengths-grid,
      .contact-links {
        grid-template-columns: 1fr;
      }
      .team-name {
        font-size: var(--text-h1);
      }
    }
  </style>

  <section class="about-section" id="intro">
    <div class="container">
      <SectionHeader tag="About" title="A B O U T" />
      <p class="about-intro" set:html={aboutIntro} />
    </div>
  </section>

  <section class="about-section" id="team">
    <div class="container">
      <SectionHeader tag="Team" title="T E A M" />
      <div class="team-card glass-card">
        <div>
          <h2 class="team-name">{heroContent.name}</h2>
          <p class="team-role">{heroContent.role}</p>
          <p class="team-location">Lives in 徐州</p>
        </div>
        <p class="team-bio" set:html={aboutIntro} />
      </div>
    </div>
  </section>

  <section class="about-section" id="experience">
    <div class="container">
      <SectionHeader tag="Experience" title="E X P E R I E N C E" />
      <div class="timeline">
        {
          experienceEntries.map((entry) => (
            <div class="timeline-item">
              <div class="timeline-period">{entry.period}</div>
              <h3 class="timeline-company">{entry.company}</h3>
              <p class="timeline-role">{entry.role}</p>
              <ul class="timeline-list">
                {entry.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
      {
        projectGroups.map((group) => (
          <div class="project-group">
            <div class="project-group-label">{group.label}</div>
            <div class="project-grid">
              {group.items.map((item) => (
                <div class="project-card glass-card">
                  <div class="project-card-head">
                    <h4 class="project-card-name">{item.icon} {item.name}</h4>
                    <span class="project-card-period">{item.period}</span>
                  </div>
                  <p class="project-card-desc">{item.description}</p>
                  <div class="project-card-techs">
                    {item.techs.map((tech) => <span class="tech-chip">{tech}</span>)}
                  </div>
                  <p class="project-card-result">{item.result}</p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="about-section" id="skills">
    <div class="container">
      <SectionHeader tag="Skills" title="S K I L L S" />
      <div class="skills-grid">
        {
          skillGroups.map((group) => (
            <div class="skill-card glass-card">
              <h3 class="skill-card-title">{group.title}</h3>
              <div class="skill-items">
                {group.items.map((item) => (
                  <div class="skill-item">
                    <span class="skill-name">{item.name}</span>
                    <span class:list={['skill-level', item.tone]}>{item.level}</span>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="about-section" id="strengths">
    <div class="container">
      <SectionHeader tag="Strengths" title="S T R E N G T H S" />
      <div class="strengths-grid">
        {
          strengths.map((item) => (
            <div class="strength-card glass-card">
              <span class="strength-icon">{item.icon}</span>
              <h3 class="strength-title">{item.title}</h3>
              <p class="strength-desc">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="about-section" id="contact">
    <div class="container">
      <SectionHeader tag="Contact" title="C O N T A C T" />
      <div class="contact-links">
        {
          contactLinks.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
              class="contact-link"
            >
              <span class="contact-icon">{link.icon}</span>
              <div>
                <div class="contact-label">{link.label}</div>
                <div class="contact-value">{link.value}</div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
