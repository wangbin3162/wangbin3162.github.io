---
import { Image } from 'astro:assets'
import BaseHead from '../components/BaseHead.astro'
import beianIcon from '../assets/site/beian.png'
import logo from '../assets/site/b-logo.png'
import avatar from '../assets/site/avatar.png'
import { openSourceItems } from '../data/opensource'
import {
  aboutIntro,
  aboutStats,
  contactLinks,
  experienceEntries,
  filingInfo,
  heroBubbles,
  heroContent,
  heroStats,
  heroTags,
  projectGroups,
  skillGroups,
  strengths
} from '../data/profile'
import { SITE_DESCRIPTION, SITE_TITLE_FULL } from '../consts'

const duplicatedOpenSourceItems = [...openSourceItems, ...openSourceItems]
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <BaseHead title={SITE_TITLE_FULL} description={SITE_DESCRIPTION} image={avatar} />
  <style>
    :root {
      --bg-start: #f0f4ff;
      --bg-end: #f5f0ff;
      --accent: #6366f1;
      --accent2: #a855f7;
      --accent-light: rgba(99,102,241,0.1);
      --accent2-light: rgba(168,85,247,0.1);
      --neon-blue: #818cf8;
      --neon-purple: #c084fc;
      --neon-pink: #f472b6;
      --glass-bg: rgba(255,255,255,0.7);
      --glass-border: rgba(255,255,255,0.5);
      --glass-blur: 12px;
      --text-primary: #1e1b4b;
      --text-secondary: #4338ca;
      --text-muted: #6b7280;
      --text-dim: #9ca3af;
      --radius: 16px;
      --radius-sm: 8px;
      --container-max: 1200px;
      --nav-height: 72px;
      --font-display: 'Outfit', sans-serif;
      --font-body: 'Noto Sans SC', sans-serif;
    }

    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: var(--nav-height);
    }

    body {
      background: linear-gradient(135deg, var(--bg-start), var(--bg-end));
      min-height: 100vh;
      font-family: var(--font-body);
      color: var(--text-primary);
      line-height: 1.7;
      overflow-x: hidden;
      padding-top: 0;
    }

    body.menu-open {
      overflow: hidden;
    }

    main {
      width: auto;
      max-width: none;
      margin: 0;
      padding: 0;
    }

    .container {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ─── Glassmorphism Card ─── */
    .glass-card {
      background: var(--glass-bg);
      backdrop-filter: blur(var(--glass-blur));
      -webkit-backdrop-filter: blur(var(--glass-blur));
      border: 1px solid var(--glass-border);
      border-radius: var(--radius);
      box-shadow: 0 4px 30px rgba(0,0,0,0.05);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .glass-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(99,102,241,0.1);
    }

    /* ─── Section Headers ─── */
    .section-header {
      text-align: center;
      margin-bottom: 60px;
    }

    .section-tag {
      display: inline-block;
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--accent);
      background: var(--accent-light);
      padding: 6px 18px;
      border-radius: 20px;
      margin-bottom: 16px;
    }

    .section-title {
      font-family: var(--font-display);
      font-size: clamp(28px, 4vw, 42px);
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 12px;
    }

    .section-divider {
      width: 60px;
      height: 3px;
      background: linear-gradient(90deg, var(--accent), var(--accent2));
      border-radius: 2px;
      margin: 0 auto;
    }

    /* ─── Scroll Reveal ─── */
    .reveal {
      opacity: 0;
      transform: translateY(40px);
      transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1),
                  transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .reveal-stagger > .reveal:nth-child(1) { transition-delay: 0s; }
    .reveal-stagger > .reveal:nth-child(2) { transition-delay: 0.08s; }
    .reveal-stagger > .reveal:nth-child(3) { transition-delay: 0.16s; }
    .reveal-stagger > .reveal:nth-child(4) { transition-delay: 0.24s; }
    .reveal-stagger > .reveal:nth-child(5) { transition-delay: 0.32s; }
    .reveal-stagger > .reveal:nth-child(6) { transition-delay: 0.4s; }
    .reveal-stagger > .reveal:nth-child(7) { transition-delay: 0.48s; }
    .reveal-stagger > .reveal:nth-child(8) { transition-delay: 0.56s; }
    .reveal-stagger > .reveal:nth-child(9) { transition-delay: 0.64s; }

    /* ─── NAVBAR ─── */
    #navbar {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: var(--nav-height);
      background: rgba(255,255,255,0.6);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255,255,255,0.4);
      z-index: 1000;
      transition: background 0.3s, box-shadow 0.3s;
    }

    #navbar.scrolled {
      background: rgba(255,255,255,0.95);
      box-shadow: 0 4px 30px rgba(0,0,0,0.08);
    }

    .nav-inner {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 24px;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
    }

    .nav-logo img {
      height: 36px;
      width: auto;
    }

    .nav-logo span {
      font-family: var(--font-display);
      font-size: 18px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .nav-links {
      display: flex;
      list-style: none;
      gap: 4px;
    }

    .nav-link {
      font-family: var(--font-display);
      font-size: 14px;
      font-weight: 500;
      color: var(--text-muted);
      text-decoration: none;
      padding: 8px 14px;
      border-radius: var(--radius-sm);
      transition: color 0.2s, background 0.2s;
    }

    .nav-link:hover,
    .nav-link.active {
      color: var(--accent);
      background: var(--accent-light);
    }

    .menu-toggle {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      width: 32px;
      height: 32px;
      position: relative;
    }

    .menu-toggle span {
      display: block;
      width: 24px;
      height: 2px;
      background: var(--text-primary);
      position: absolute;
      left: 4px;
      transition: all 0.3s ease;
    }

    .menu-toggle span:nth-child(1) { top: 8px; }
    .menu-toggle span:nth-child(2) { top: 15px; }
    .menu-toggle span:nth-child(3) { top: 22px; }

    .menu-toggle.open span:nth-child(1) { top: 15px; transform: rotate(45deg); }
    .menu-toggle.open span:nth-child(2) { opacity: 0; }
    .menu-toggle.open span:nth-child(3) { top: 15px; transform: rotate(-45deg); }

    .mobile-menu {
      display: none;
      position: fixed;
      top: var(--nav-height);
      left: 0; right: 0; bottom: 0;
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      z-index: 999;
      padding: 24px;
      opacity: 0;
      transform: translateY(-20px);
      transition: opacity 0.3s, transform 0.3s;
    }

    .mobile-menu.open {
      display: flex;
      flex-direction: column;
      gap: 4px;
      opacity: 1;
      transform: translateY(0);
    }

    .mobile-menu .nav-link {
      font-size: 18px;
      padding: 14px 16px;
      border-radius: var(--radius-sm);
    }

    @media (max-width: 768px) {
      .nav-links { display: none; }
      .menu-toggle { display: block; }
    }

    /* ─── HERO ─── */
    #hero {
      padding-top: calc(var(--nav-height) + 60px);
      padding-bottom: 80px;
      min-height: 100vh;
      display: flex;
      align-items: center;
    }

    .hero-inner {
      display: flex;
      align-items: center;
      gap: 60px;
    }

    .hero-text {
      flex: 1;
    }

    .hero-greeting {
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 500;
      color: var(--accent);
      margin-bottom: 8px;
      letter-spacing: 1px;
    }

    .hero-name {
      font-family: var(--font-display);
      font-size: clamp(42px, 6vw, 72px);
      font-weight: 800;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.1;
      margin-bottom: 12px;
    }

    .hero-role {
      font-family: var(--font-display);
      font-size: clamp(18px, 2.5vw, 24px);
      font-weight: 400;
      color: var(--text-muted);
      margin-bottom: 24px;
    }

    .hero-stats {
      display: flex;
      gap: 24px;
      margin-bottom: 28px;
      flex-wrap: wrap;
    }

    .hero-stat {
      text-align: center;
    }

    .hero-stat-num {
      font-family: var(--font-display);
      font-size: 28px;
      font-weight: 700;
      color: var(--accent);
      line-height: 1.2;
    }

    .hero-stat-label {
      font-size: 13px;
      color: var(--text-muted);
    }

    .hero-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .hero-tag {
      font-size: 13px;
      font-weight: 500;
      padding: 6px 16px;
      border-radius: 20px;
      background: var(--glass-bg);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid var(--glass-border);
      color: var(--text-secondary);
    }

    .hero-avatar-wrapper {
      position: relative;
      flex-shrink: 0;
    }

    .hero-avatar-ring {
      width: clamp(200px, 22vw, 300px);
      height: clamp(200px, 22vw, 300px);
      border-radius: 50%;
      padding: 5px;
      background: linear-gradient(135deg, var(--neon-blue), var(--neon-purple), var(--neon-pink));
      box-shadow: 0 0 40px rgba(129,140,248,0.3), 0 0 80px rgba(192,132,252,0.15);
    }

    .hero-avatar {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      display: block;
    }

    .floating-bubble {
      position: absolute;
      padding: 6px 14px;
      background: var(--glass-bg);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid var(--glass-border);
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
      color: var(--text-secondary);
      white-space: nowrap;
      pointer-events: none;
      animation: float 6s ease-in-out infinite;
      box-shadow: 0 2px 12px rgba(99,102,241,0.1);
    }

    .floating-bubble:nth-child(2) { animation-delay: -1s; animation-duration: 7s; }
    .floating-bubble:nth-child(3) { animation-delay: -2.5s; animation-duration: 5.5s; }
    .floating-bubble:nth-child(4) { animation-delay: -0.5s; animation-duration: 6.5s; }
    .floating-bubble:nth-child(5) { animation-delay: -3s; animation-duration: 8s; }
    .floating-bubble:nth-child(6) { animation-delay: -1.8s; animation-duration: 5s; }

    .bubble-1 { top: -10px; right: -20px; }
    .bubble-2 { top: 20%; left: -60px; }
    .bubble-3 { bottom: 20%; right: -50px; }
    .bubble-4 { bottom: -10px; left: -30px; }
    .bubble-5 { top: 50%; right: -70px; }
    .bubble-6 { top: 10%; left: -80px; }

    @keyframes float {
      0%, 100% { transform: translate(0, 0); }
      25% { transform: translate(8px, -12px); }
      50% { transform: translate(-6px, -8px); }
      75% { transform: translate(10px, 6px); }
    }

    @media (max-width: 768px) {
      .hero-inner {
        flex-direction: column-reverse;
        text-align: center;
        gap: 40px;
      }
      .hero-stats { justify-content: center; }
      .hero-tags { justify-content: center; }
      .floating-bubble { display: none; }
      .hero-avatar-ring {
        width: 180px;
        height: 180px;
      }
    }

    /* ─── ABOUT ─── */
    #about {
      padding: 100px 0;
    }

    .about-text {
      font-size: 16px;
      color: var(--text-muted);
      line-height: 1.9;
      max-width: 800px;
      margin: 0 auto 48px;
      text-align: center;
    }

    .about-text strong {
      color: var(--text-primary);
      font-weight: 700;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .stat-card {
      padding: 28px 20px;
      text-align: center;
    }

    .stat-card-num {
      font-family: var(--font-display);
      font-size: 32px;
      font-weight: 700;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.2;
      margin-bottom: 8px;
    }

    .stat-card-label {
      font-size: 14px;
      color: var(--text-muted);
    }

    @media (max-width: 768px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }

    /* ─── NEON TIMELINE ─── */
    .neon-timeline {
      position: relative;
      padding: 20px 0;
    }

    .neon-timeline::before {
      content: '';
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      top: 0; bottom: 0;
      width: 3px;
      background: linear-gradient(to bottom, var(--neon-blue), var(--neon-purple), var(--neon-pink));
      border-radius: 2px;
      box-shadow: 0 0 12px var(--neon-blue), 0 0 24px rgba(129,140,248,0.2);
    }

    .timeline-entry {
      display: flex;
      align-items: flex-start;
      margin-bottom: 48px;
      position: relative;
    }

    .timeline-entry:last-child { margin-bottom: 0; }

    .timeline-entry:nth-child(odd) {
      flex-direction: row;
      padding-right: calc(50% + 36px);
      text-align: right;
    }

    .timeline-entry:nth-child(even) {
      flex-direction: row-reverse;
      padding-left: calc(50% + 36px);
      text-align: left;
    }

    .timeline-node {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      top: 24px;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--accent);
      border: 3px solid #fff;
      z-index: 2;
      box-shadow: 0 0 12px var(--accent), 0 0 24px rgba(99,102,241,0.4);
      animation: nodePulse 2.5s ease-in-out infinite;
    }

    @keyframes nodePulse {
      0%, 100% { box-shadow: 0 0 12px var(--accent), 0 0 24px rgba(99,102,241,0.4); }
      50% { box-shadow: 0 0 20px var(--accent), 0 0 40px rgba(99,102,241,0.6); }
    }

    .timeline-card {
      padding: 28px;
      width: 100%;
    }

    .timeline-period {
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 600;
      color: var(--accent);
      letter-spacing: 1px;
      margin-bottom: 8px;
    }

    .timeline-company {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 4px;
    }

    .timeline-role {
      font-size: 14px;
      color: var(--accent2);
      font-weight: 500;
      margin-bottom: 16px;
    }

    .timeline-list {
      list-style: none;
      padding: 0;
    }

    .timeline-list li {
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.8;
      padding-left: 16px;
      position: relative;
      margin-bottom: 4px;
    }

    .timeline-list li::before {
      content: '▸';
      position: absolute;
      left: 0;
      color: var(--accent);
    }

    @media (max-width: 1023px) {
      .neon-timeline::before {
        left: 20px;
        transform: none;
      }
      .timeline-entry:nth-child(odd),
      .timeline-entry:nth-child(even) {
        flex-direction: row;
        padding-right: 0;
        padding-left: 56px;
        text-align: left;
      }
      .timeline-node {
        left: 20px;
      }
    }

    /* ─── PROJECT GROUP LABEL ─── */
    .project-group {
      margin-bottom: 64px;
    }

    .project-group:last-child { margin-bottom: 0; }

    .project-group-label {
      text-align: center;
      margin-bottom: 40px;
    }

    .project-group-label span {
      display: inline-block;
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 600;
      padding: 8px 24px;
      border-radius: 24px;
      background: linear-gradient(135deg, var(--accent-light), var(--accent2-light));
      color: var(--accent);
      border: 1px solid rgba(99,102,241,0.15);
    }

    .project-icon {
      font-size: 24px;
      margin-bottom: 8px;
      display: block;
    }

    .project-name {
      font-family: var(--font-display);
      font-size: 18px;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 4px;
    }

    .project-desc {
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.7;
      margin-bottom: 12px;
    }

    .project-techs {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 12px;
    }

    .project-techs.right { justify-content: flex-end; }

    .tech-chip {
      font-size: 12px;
      font-weight: 500;
      padding: 3px 10px;
      border-radius: 12px;
      background: var(--accent-light);
      color: var(--accent);
    }

    .project-result {
      font-size: 13px;
      font-weight: 600;
      color: var(--accent2);
    }

    /* ─── PROJECTS SECTION ─── */
    #projects {
      padding: 100px 0;
    }

    #experience {
      padding: 100px 0;
    }

    /* ─── OPEN SOURCE SCROLL WALL ─── */
    #opensource {
      padding: 100px 0;
      overflow: hidden;
    }

    .oss-stars-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 600;
      color: #f59e0b;
      background: rgba(245,158,11,0.1);
      border: 1px solid rgba(245,158,11,0.2);
      padding: 8px 20px;
      border-radius: 24px;
      margin-bottom: 48px;
    }

    .scroll-wall-container {
      overflow: hidden;
      mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
      padding: 20px 0;
    }

    .scroll-wall-track {
      display: flex;
      gap: 20px;
      width: max-content;
      animation: scrollWall 80s linear infinite;
      will-change: transform;
    }

    .scroll-wall-track:hover {
      animation-play-state: paused;
    }

    @keyframes scrollWall {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    .oss-card {
      width: 300px;
      flex-shrink: 0;
      padding: 0;
      overflow: hidden;
      cursor: default;
    }

    .oss-card-img {
      width: 100%;
      aspect-ratio: 16/9;
      object-fit: cover;
      display: block;
      background: linear-gradient(135deg, var(--accent-light), var(--accent2-light));
    }

    .oss-card-body {
      padding: 16px;
    }

    .oss-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
    }

    .oss-card-name {
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .oss-card-stars {
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 600;
      color: #f59e0b;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .oss-card-desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 12px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .oss-card-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 12px;
    }

    .oss-card-links {
      display: flex;
      gap: 8px;
    }

    .oss-link {
      font-size: 12px;
      font-weight: 500;
      text-decoration: none;
      padding: 4px 12px;
      border-radius: 12px;
      transition: all 0.2s;
    }

    .oss-link-gh {
      background: var(--text-primary);
      color: #fff;
    }

    .oss-link-gh:hover { background: var(--accent); }

    .oss-link-demo {
      background: var(--accent-light);
      color: var(--accent);
      border: 1px solid rgba(99,102,241,0.2);
    }

    .oss-link-demo:hover { background: var(--accent); color: #fff; }

    .oss-card-emoji-fallback {
      width: 100%;
      aspect-ratio: 16/9;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 48px;
      background: linear-gradient(135deg, var(--accent-light), var(--accent2-light));
    }

    @media (max-width: 768px) {
      .oss-card { width: 260px; }
      .scroll-wall-track { animation-duration: 60s; }
    }

    /* ─── View more button ─── */
    .view-more-wrap {
      text-align: center;
      margin-top: 48px;
    }

    .view-more-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.85rem 2rem;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      color: #fff;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      box-shadow: 0 8px 24px rgba(99, 102, 241, 0.2);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .view-more-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 32px rgba(99, 102, 241, 0.3);
    }

    .view-more-btn span {
      font-size: 1.1rem;
    }

    /* ─── TECH STACK ─── */
    #skills {
      padding: 100px 0;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .skill-category {
      padding: 28px;
    }

    .skill-category-title {
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .skill-category-title .cat-icon {
      font-size: 20px;
    }

    .skill-items {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .skill-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 14px;
    }

    .skill-name {
      color: var(--text-primary);
      font-weight: 500;
    }

    .skill-level {
      font-size: 11px;
      font-weight: 600;
      padding: 2px 10px;
      border-radius: 10px;
    }

    .level-expert {
      background: rgba(99,102,241,0.12);
      color: var(--accent);
      border: 1px solid rgba(99,102,241,0.25);
    }

    .level-proficient {
      background: rgba(168,85,247,0.1);
      color: var(--accent2);
      border: 1px solid rgba(168,85,247,0.2);
    }

    .level-familiar {
      background: rgba(107,114,128,0.08);
      color: var(--text-muted);
      border: 1px solid rgba(107,114,128,0.15);
    }

    .skills-legend {
      display: flex;
      justify-content: center;
      gap: 24px;
      margin-top: 32px;
      font-size: 13px;
      color: var(--text-muted);
    }

    .skills-legend span {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    @media (max-width: 1023px) {
      .skills-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 768px) {
      .skills-grid { grid-template-columns: 1fr; }
    }

    /* ─── STRENGTHS ─── */
    #strengths {
      padding: 100px 0;
    }

    .strengths-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .strength-card {
      padding: 32px 24px;
      text-align: center;
    }

    .strength-icon {
      font-size: 36px;
      margin-bottom: 16px;
      display: block;
    }

    .strength-title {
      font-family: var(--font-display);
      font-size: 17px;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 12px;
    }

    .strength-desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.8;
    }

    @media (max-width: 1023px) {
      .strengths-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 768px) {
      .strengths-grid { grid-template-columns: 1fr; }
    }

    /* ─── CONTACT ─── */
    #contact {
      padding: 100px 0;
    }

    .contact-subtitle {
      text-align: center;
      font-size: 15px;
      color: var(--text-muted);
      margin-bottom: 48px;
      margin-top: -40px;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      max-width: 900px;
      margin: 0 auto;
    }

    .contact-card {
      padding: 24px;
      text-align: center;
      text-decoration: none;
      display: block;
    }

    .contact-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(99,102,241,0.15);
    }

    .contact-icon {
      font-size: 28px;
      margin-bottom: 12px;
      display: block;
    }

    .contact-label {
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 6px;
    }

    .contact-value {
      font-size: 15px;
      color: var(--text-primary);
      font-weight: 500;
      word-break: break-all;
    }

    /* ─── FOOTER ─── */
    footer {
      padding: 40px 24px;
      text-align: center;
      border-top: 1px solid rgba(99,102,241,0.1);
    }

    .footer-icp {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--text-dim);
      margin-bottom: 12px;
    }

    .footer-icp a {
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.2s;
    }

    .footer-icp a:hover { color: var(--accent); }

    .footer-gongan {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .footer-gongan-icon {
      width: 18px;
      height: 20px;
      flex: 0 0 auto;
    }

    .footer-brand {
      font-size: 12px;
      color: var(--text-dim);
    }

    .footer-brand a {
      color: var(--text-dim);
      text-decoration: none;
      transition: color 0.2s;
      font-family: var(--font-display);
      font-weight: 500;
    }

    .footer-brand a:hover { color: var(--accent); }
  </style>
</head>
<body>

  <!-- ═══ NAVBAR ═══ -->
  <nav id="navbar">
    <div class="nav-inner">
      <a href="#hero" class="nav-logo">
        <Image src={logo} alt="Logo" widths={[72]} sizes="36px" />
        <span>王彬</span>
      </a>
      <ul class="nav-links">
        <li><a href="#hero" class="nav-link active">首页</a></li>
        <li><a href="#about" class="nav-link">关于</a></li>
        <li><a href="#experience" class="nav-link">轨迹</a></li>
        <li><a href="#projects" class="nav-link">项目</a></li>
        <li><a href="#opensource" class="nav-link">开源</a></li>
        <li><a href="#skills" class="nav-link">技术</a></li>
        <li><a href="#strengths" class="nav-link">擅长</a></li>
        <li><a href="#contact" class="nav-link">联系</a></li>
      </ul>
      <button class="menu-toggle" id="menu-toggle" aria-label="菜单">
        <span></span><span></span><span></span>
      </button>
    </div>
    <div class="mobile-menu" id="mobile-menu">
      <a href="#hero" class="nav-link">首页</a>
      <a href="#about" class="nav-link">关于</a>
      <a href="#experience" class="nav-link">轨迹</a>
      <a href="#projects" class="nav-link">项目</a>
      <a href="#opensource" class="nav-link">开源</a>
      <a href="#skills" class="nav-link">技术</a>
      <a href="#strengths" class="nav-link">擅长</a>
      <a href="#contact" class="nav-link">联系</a>
    </div>
  </nav>

  <main>
    <!-- ═══ HERO ═══ -->
    <section id="hero">
      <div class="container">
        <div class="hero-inner">
          <div class="hero-text">
            <p class="hero-greeting reveal">{heroContent.greeting}</p>
            <h1 class="hero-name reveal">{heroContent.name}</h1>
            <p class="hero-role reveal">{heroContent.role}</p>
            <div class="hero-stats reveal">
              {
                heroStats.map((stat) => (
                  <div class="hero-stat">
                    <div class="hero-stat-num">{stat.value}</div>
                    <div class="hero-stat-label">{stat.label}</div>
                  </div>
                ))
              }
            </div>
            <div class="hero-tags reveal">
              {heroTags.map((tag) => <span class="hero-tag">{tag}</span>)}
            </div>
          </div>
          <div class="hero-avatar-wrapper reveal">
            <div class="hero-avatar-ring">
              <Image src={avatar} alt="王彬" class="hero-avatar" widths={[720]} sizes="(max-width: 640px) 180px, 300px" />
            </div>
            {heroBubbles.map((bubble) => <span class:list={['floating-bubble', bubble.className]}>{bubble.text}</span>)}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ ABOUT ═══ -->
    <section id="about">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-tag">About Me</span>
          <h2 class="section-title">关于我</h2>
          <div class="section-divider"></div>
        </div>
        <p class="about-text reveal" set:html={aboutIntro}></p>
        <div class="stats-grid reveal-stagger">
          {
            aboutStats.map((stat) => (
              <div class="stat-card glass-card reveal">
                <div class="stat-card-num">{stat.value}</div>
                <div class="stat-card-label">{stat.label}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ═══ EXPERIENCE ═══ -->
    <section id="experience">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-tag">Journey</span>
          <h2 class="section-title">成长轨迹</h2>
          <div class="section-divider"></div>
        </div>
        <div class="neon-timeline">
          {
            experienceEntries.map((entry) => (
              <div class="timeline-entry reveal">
                <div class="timeline-node"></div>
                <div class="timeline-card glass-card">
                  <div class="timeline-period">{entry.period}</div>
                  <div class="timeline-company">{entry.company}</div>
                  <div class="timeline-role">{entry.role}</div>
                  <ul class="timeline-list">
                    {entry.items.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ═══ PROJECTS ═══ -->
    <section id="projects">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-tag">Projects</span>
          <h2 class="section-title">做过的东西</h2>
          <div class="section-divider"></div>
        </div>

        {
          projectGroups.map((group) => (
            <div class="project-group">
              <div class="project-group-label reveal"><span>{group.label}</span></div>
              <div class="neon-timeline">
                {
                  group.items.map((item, index) => (
                    <div class="timeline-entry reveal">
                      <div class="timeline-node"></div>
                      <div class="timeline-card glass-card">
                        <span class="project-icon">{item.icon}</span>
                        <div class="timeline-period">{item.period}</div>
                        <div class="project-name">{item.name}</div>
                        <p class="project-desc">{item.description}</p>
                        <div class:list={['project-techs', index % 2 === 1 ? 'right' : '']}>
                          {item.techs.map((tech) => <span class="tech-chip">{tech}</span>)}
                        </div>
                        <div class="project-result">{item.result}</div>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ═══ OPEN SOURCE ═══ -->
    <section id="opensource">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-tag">Open Source</span>
          <h2 class="section-title">开源作品</h2>
          <div class="section-divider"></div>
        </div>
        <div style="text-align:center" class="reveal">
          <span class="oss-stars-badge">⭐ GitHub Stars 682+</span>
        </div>
      </div>
      <div class="scroll-wall-container reveal">
        <div class="scroll-wall-track" id="scroll-wall">
          {
            duplicatedOpenSourceItems.map((item) => (
              <div class="oss-card glass-card">
                <Image src={item.image} alt={item.name} class="oss-card-img" widths={[400]} sizes="(max-width: 768px) 260px, 300px" />
                <div class="oss-card-body">
                  <div class="oss-card-header">
                    <span class="oss-card-name">{item.icon} {item.name}</span>
                    <span class="oss-card-stars">⭐ {item.stars}</span>
                  </div>
                  <p class="oss-card-desc">{item.description}</p>
                  <div class="oss-card-tags">
                    {item.techs.map((tech) => <span class="tech-chip">{tech}</span>)}
                  </div>
                  <div class="oss-card-links">
                    <a href={item.github} target="_blank" rel="noreferrer" class="oss-link oss-link-gh">GitHub</a>
                    <a href={item.demo} target="_blank" rel="noreferrer" class="oss-link oss-link-demo">Demo</a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <div class="view-more-wrap reveal">
        <a href="/opensource" class="view-more-btn">
          查看更多
          <span>→</span>
        </a>
      </div>
    </section>

    <!-- ═══ TECH STACK ═══ -->
    <section id="skills">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-tag">Skills</span>
          <h2 class="section-title">技术栈</h2>
          <div class="section-divider"></div>
        </div>
        <div class="skills-grid reveal-stagger">
          {
            skillGroups.map((group) => (
              <div class="skill-category glass-card reveal">
                <div class="skill-category-title"><span class="cat-icon">{group.title.split(' ')[0]}</span> {group.title.split(' ').slice(1).join(' ')}</div>
                <div class="skill-items">
                  {
                    group.items.map((item) => (
                      <div class="skill-item">
                        <span class="skill-name">{item.name}</span>
                        <span class:list={['skill-level', `level-${item.tone}`]}>{item.level}</span>
                      </div>
                    ))
                  }
                </div>
              </div>
            ))
          }
        </div>
        <div class="skills-legend reveal">
          <span><span class="legend-dot" style="background:var(--accent)"></span> 精通</span>
          <span><span class="legend-dot" style="background:var(--accent2)"></span> 熟练</span>
          <span><span class="legend-dot" style="background:var(--text-muted)"></span> 掌握</span>
        </div>
      </div>
    </section>

    <!-- ═══ STRENGTHS ═══ -->
    <section id="strengths">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-tag">What I Do Best</span>
          <h2 class="section-title">擅长的事</h2>
          <div class="section-divider"></div>
        </div>
        <div class="strengths-grid reveal-stagger">
          {
            strengths.map((item) => (
              <div class="strength-card glass-card reveal">
                <span class="strength-icon">{item.icon}</span>
                <div class="strength-title">{item.title}</div>
                <p class="strength-desc">{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ═══ CONTACT ═══ -->
    <section id="contact">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-tag">Connect</span>
          <h2 class="section-title">联系方式</h2>
          <div class="section-divider"></div>
        </div>
        <p class="contact-subtitle reveal">有趣的项目、技术交流、或者单纯想聊聊，都欢迎找我</p>
        <div class="contact-grid reveal-stagger">
          {
            contactLinks.map((link) => (
              <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noreferrer' : undefined} class="contact-card glass-card reveal">
                <span class="contact-icon">{link.icon}</span>
                <div class="contact-label">{link.label}</div>
                <div class="contact-value">{link.value}</div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <!-- ═══ FOOTER ═══ -->
  <footer>
    <div class="footer-icp">
      <a href={filingInfo.icpHref} target="_blank" rel="noreferrer">{filingInfo.icpLabel}</a>
      <a
        class="footer-gongan"
        href={filingInfo.gonganHref}
        rel="noreferrer"
        target="_blank"
      >
        <Image class="footer-gongan-icon" src={beianIcon} alt="" widths={[32]} sizes="16px" />
        <span>{filingInfo.gonganLabel}</span>
      </a>
    </div>
    <div class="footer-brand">
      <a href="https://deerflow.tech" target="_blank" rel="noreferrer">✦ Created By Deerflow</a>
    </div>
  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // ─── Scroll Reveal ───
      const revealEls = document.querySelectorAll('.reveal')
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible')
            revealObserver.unobserve(entry.target)
          }
        })
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' })

      revealEls.forEach(el => revealObserver.observe(el))

      // ─── Navbar scroll state ───
      const navbar = document.getElementById('navbar')
      const sections = document.querySelectorAll('main > section')
      const navLinks = document.querySelectorAll('.nav-links .nav-link, .mobile-menu .nav-link')

      function onScroll() {
        const sy = window.scrollY
        navbar?.classList.toggle('scrolled', sy > 50)

        let current = ''
        sections.forEach(sec => {
          if (sy >= sec.offsetTop - 120) current = sec.id
        })
        navLinks.forEach(link => {
          link.classList.toggle('active', link.getAttribute('href') === '#' + current)
        })
      }

      window.addEventListener('scroll', onScroll, { passive: true })
      onScroll()

      // ─── Hamburger menu ───
      const toggle = document.getElementById('menu-toggle')
      const mobileMenu = document.getElementById('mobile-menu')

      toggle?.addEventListener('click', () => {
        toggle.classList.toggle('open')
        mobileMenu?.classList.toggle('open')
        document.body.classList.toggle('menu-open')
      })

      mobileMenu?.querySelectorAll('.nav-link').forEach(link => {
        link.addEventListener('click', () => {
          toggle?.classList.remove('open')
          mobileMenu.classList.remove('open')
          document.body.classList.remove('menu-open')
        })
      })

      // ─── Scroll wall touch support ───
      const scrollTrack = document.getElementById('scroll-wall')
      if (scrollTrack) {
        scrollTrack.addEventListener('touchstart', () => {
          scrollTrack.style.animationPlayState = 'paused'
        }, { passive: true })
        scrollTrack.addEventListener('touchend', () => {
          scrollTrack.style.animationPlayState = 'running'
        }, { passive: true })
      }
    })
  </script>
</body>
</html>
