---
import { getImage } from 'astro:assets'
import ProjectMarquee from '../components/ProjectMarquee.vue'
import SectionHeader from '../components/SectionHeader.astro'
import avatar from '../assets/site/avatar.png'
import { openSourceItems } from '../data/opensource'
import {
  aboutIntro,
  aboutStats,
  contactLinks,
  experienceEntries,
  heroContent,
  heroStats,
  heroTags
} from '../data/profile'
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE_DESCRIPTION, SITE_TITLE_FULL } from '../consts'

const featuredProjects = openSourceItems.slice(0, 5)

// 预优化图片为 WebP，把 URL 传给 Vue Island 组件（Vue 内不能直接用 Astro <Image>）
const featuredCards = await Promise.all(
  featuredProjects.map(async (item) => {
    const img = await getImage({ src: item.image, width: 400, format: 'webp' })
    return {
      name: item.name,
      year: item.year,
      techs: item.techs,
      description: item.description,
      imageSrc: img.src,
      imageAlt: item.name,
      href: `/project/${item.name}`
    }
  })
)
---

<BaseLayout
  title={SITE_TITLE_FULL}
  description={SITE_DESCRIPTION}
  image={avatar}
  barbaNamespace="home"
>
  <style>
    :global(main) {
      width: 100%;
      max-width: none;
      padding: 0;
      margin: 0;
    }
    .home-section {
      padding: var(--space-2xl) 0;
    }
    .container {
      width: min(var(--container-max), calc(100% - 48px));
      margin: 0 auto;
    }
    /* Hero */
    .hero {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: calc(var(--nav-height) + var(--space-xl)) 0 var(--space-xl);
    }
    .hero-inner {
      text-align: center;
    }
    .hero-greeting {
      margin-bottom: var(--space-sm);
      color: var(--accent);
      font-family: var(--font-display);
      font-size: var(--text-small);
      font-weight: 500;
      letter-spacing: var(--ls-nav);
      text-transform: uppercase;
    }
    .hero-name {
      margin-bottom: var(--space-md);
      font-family: var(--font-display);
      font-size: var(--text-hero-xl);
      font-weight: 700;
      line-height: 1.05;
    }
    .hero-role {
      margin-bottom: var(--space-lg);
      color: var(--text-secondary);
      font-size: var(--text-h2);
    }
    .hero-stats {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-lg);
      margin-bottom: var(--space-lg);
    }
    .hero-stat {
      text-align: center;
    }
    .hero-stat-value {
      color: var(--accent);
      font-family: var(--font-display);
      font-size: var(--text-h1);
      font-weight: 700;
      line-height: 1.2;
    }
    .hero-stat-label {
      color: var(--text-muted);
      font-size: var(--text-small);
      letter-spacing: var(--ls-tag);
    }
    .hero-tags {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-sm);
    }
    /* Projects marquee */
    .projects-section {
      overflow: hidden;
    }
    .projects-section .container {
      margin-bottom: var(--space-lg);
    }
    .projects-marquee-wrap {
      width: 100%;
    }
    /* What I Do */
    .what-i-do-intro {
      max-width: 800px;
      color: var(--text-secondary);
      font-size: var(--text-h2);
      line-height: 1.6;
    }
    .what-i-do-intro :global(strong) {
      color: var(--text-primary);
      font-weight: 700;
    }
    .what-i-do-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-md);
      margin-top: var(--space-xl);
    }
    .what-i-do-stat {
      padding: var(--space-md);
      text-align: center;
    }
    .what-i-do-stat-value {
      color: var(--accent);
      font-family: var(--font-display);
      font-size: var(--text-h1);
      font-weight: 700;
      line-height: 1.2;
    }
    .what-i-do-stat-label {
      color: var(--text-muted);
      font-size: var(--text-small);
    }
    /* Experience */
    .timeline {
      display: grid;
      gap: var(--space-lg);
    }
    .timeline-item {
      padding-bottom: var(--space-md);
      border-bottom: 1px solid var(--border);
    }
    .timeline-period {
      color: var(--accent);
      font-family: var(--font-display);
      font-size: var(--text-small);
      font-weight: 600;
      letter-spacing: var(--ls-tag);
    }
    .timeline-company {
      margin: var(--space-xs) 0;
      font-family: var(--font-display);
      font-size: var(--text-h3);
      font-weight: 600;
    }
    .timeline-role {
      color: var(--text-secondary);
      margin-bottom: var(--space-sm);
    }
    .timeline-list {
      padding-left: 1.2rem;
      color: var(--text-muted);
    }
    .timeline-list li {
      margin-bottom: var(--space-xs);
    }
    /* Contact */
    .contact-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-md);
    }
    .contact-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-xs);
      padding: var(--space-sm) var(--space-md);
      border: 1px solid var(--border);
      border-radius: var(--radius-full);
      color: var(--text-secondary);
      font-size: var(--text-small);
      transition: color 0.2s var(--ease-in-out), border-color 0.2s var(--ease-in-out);
    }
    .contact-link:hover {
      color: var(--accent);
      border-color: var(--accent);
    }
    @media (max-width: 768px) {
      .what-i-do-stats {
        grid-template-columns: repeat(2, 1fr);
      }
      .hero-stats {
        gap: var(--space-md);
      }
    }
  </style>

  <section class="hero" id="hero">
    <div class="container">
      <div class="hero-inner">
        <p class="hero-greeting">{heroContent.greeting}</p>
        <h1 class="hero-name" data-split-text="">{heroContent.name}</h1>
        <p class="hero-role">{heroContent.role}</p>
        <div class="hero-stats">
          {
            heroStats.map((stat) => (
              <div class="hero-stat">
                <div class="hero-stat-value">{stat.value}</div>
                <div class="hero-stat-label">{stat.label}</div>
              </div>
            ))
          }
        </div>
        <div class="hero-tags">
          {heroTags.map((tag) => <span class="tech-chip">{tag}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="home-section projects-section" id="projects">
    <div class="container">
      <SectionHeader tag="Projects" title="P R O J E C T S" splitText />
    </div>
    <div class="projects-marquee-wrap reveal">
      <ProjectMarquee client:load projects={featuredCards} />
    </div>
  </section>

  <section class="home-section" id="what-i-do">
    <div class="container">
      <SectionHeader tag="What I Do" title="W H A T&nbsp;&nbsp;I&nbsp;&nbsp;D O" splitText />
      <p class="what-i-do-intro reveal" set:html={aboutIntro} />
      <div class="what-i-do-stats reveal-stagger" data-reveal-stagger="0.15">
        {
          aboutStats.slice(0, 3).map((stat) => (
            <div class="what-i-do-stat glass-card">
              <div class="what-i-do-stat-value">{stat.value}</div>
              <div class="what-i-do-stat-label">{stat.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-section" id="experience">
    <div class="container">
      <SectionHeader tag="Experience" title="E X P E R I E N C E" splitText />
      <div class="timeline reveal-stagger" data-reveal-stagger="0.2">
        {
          experienceEntries.map((entry) => (
            <div class="timeline-item">
              <div class="timeline-period">{entry.period}</div>
              <h3 class="timeline-company">{entry.company}</h3>
              <p class="timeline-role">{entry.role}</p>
              <ul class="timeline-list">
                {entry.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-section" id="contact">
    <div class="container">
      <SectionHeader tag="Contact" title="C O N T A C T" splitText />
      <div class="contact-links reveal-stagger" data-reveal-stagger="0.1">
        {
          contactLinks.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
              class="contact-link"
            >
              <span>{link.icon}</span>
              <span>{link.value}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
