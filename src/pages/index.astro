---
import { Image } from 'astro:assets'
import BaseHead from '../components/BaseHead.astro'
import avatar from '../assets/site/avatar.png'
import beianIcon from '../assets/site/beian.png'
import { heroContent, heroStats, heroTags, filingInfo } from '../data/profile'
import { SITE_TITLE_FULL, SITE_DESCRIPTION } from '../consts'
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <BaseHead title={SITE_TITLE_FULL} description={SITE_DESCRIPTION} image={avatar} />
  <style>
    :root {
      --bg-start: #f0f4ff;
      --bg-end: #f5f0ff;
      --accent: #6366f1;
      --accent2: #a855f7;
      --glass-bg: rgba(255, 255, 255, 0.7);
      --glass-border: rgba(255, 255, 255, 0.5);
      --text-primary: #1e1b4b;
      --text-muted: #6b7280;
      --radius: 24px;
      --font-display: 'Outfit', sans-serif;
      --font-body: 'Noto Sans SC', sans-serif;
    }

    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: var(--font-body);
      color: var(--text-primary);
      min-height: 100vh;
      background: linear-gradient(135deg, var(--bg-start), var(--bg-end));
      display: flex;
      flex-direction: column;
      line-height: 1.6;
    }

    main {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .hero-card {
      width: 100%;
      max-width: 720px;
      text-align: center;
      padding: 56px 40px;
      background: var(--glass-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius);
      box-shadow: 0 8px 40px rgba(99, 102, 241, 0.1);
    }

    .avatar {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      object-fit: cover;
      margin-bottom: 24px;
      box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.6), 0 12px 32px rgba(99, 102, 241, 0.2);
    }

    .greeting {
      font-family: var(--font-display);
      font-size: 15px;
      font-weight: 500;
      color: var(--accent);
      margin-bottom: 8px;
      letter-spacing: 1px;
    }

    .name {
      font-family: var(--font-display);
      font-size: clamp(40px, 8vw, 64px);
      font-weight: 800;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.1;
      margin-bottom: 12px;
    }

    .role {
      font-family: var(--font-display);
      font-size: clamp(16px, 3vw, 20px);
      color: var(--text-muted);
      margin-bottom: 28px;
    }

    .stats {
      display: flex;
      justify-content: center;
      gap: 32px;
      margin-bottom: 28px;
      flex-wrap: wrap;
    }

    .stat-num {
      font-family: var(--font-display);
      font-size: 28px;
      font-weight: 700;
      color: var(--accent);
      line-height: 1.2;
    }

    .stat-label {
      font-size: 13px;
      color: var(--text-muted);
    }

    .tags {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    .tag {
      font-size: 13px;
      font-weight: 500;
      padding: 6px 16px;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.6);
      border: 1px solid rgba(99, 102, 241, 0.15);
      color: var(--accent);
    }

    footer {
      padding: 24px;
      text-align: center;
      font-size: 12px;
      color: var(--text-muted);
      border-top: 1px solid rgba(99, 102, 241, 0.08);
    }

    footer a {
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.2s;
    }

    footer a:hover {
      color: var(--accent);
    }

    .gongan {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-left: 12px;
    }

    .gongan-icon {
      width: 16px;
      height: 18px;
      flex: 0 0 auto;
    }

    @media (max-width: 480px) {
      .hero-card {
        padding: 40px 24px;
      }
      .stats {
        gap: 20px;
      }
      .gongan {
        margin-left: 0;
        margin-top: 8px;
      }
    }
  </style>
</head>
<body>
  <main>
    <section class="hero-card">
      <Image
        src={avatar}
        alt="王彬"
        widths={[280]}
        sizes="140px"
        class="avatar"
      />
      <p class="greeting">{heroContent.greeting}</p>
      <h1 class="name">{heroContent.name}</h1>
      <p class="role">{heroContent.role}</p>
      <div class="stats">
        {
          heroStats.map((stat) => (
            <div class="stat">
              <div class="stat-num">{stat.value}</div>
              <div class="stat-label">{stat.label}</div>
            </div>
          ))
        }
      </div>
      <div class="tags">
        {heroTags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </section>
  </main>

  <footer>
    <a href={filingInfo.icpHref} target="_blank" rel="noreferrer">{filingInfo.icpLabel}</a>
    <span class="gongan">
      <Image
        class="gongan-icon"
        src={beianIcon}
        alt=""
        widths={[32]}
        sizes="16px"
      />
      <a href={filingInfo.gonganHref} target="_blank" rel="noreferrer">{filingInfo.gonganLabel}</a>
    </span>
  </footer>
</body>
</html>
