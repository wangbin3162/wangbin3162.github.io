---
import ModeToggle from '../components/ModeToggle.astro'
import CreativeHero from '../components/creative/CreativeHero.astro'
import CreativeFolders from '../components/creative/CreativeFolders.astro'
import CreativeReceipts from '../components/creative/CreativeReceipts.astro'
import MinimalIntro from '../components/minimal/MinimalIntro.astro'
import MinimalProducts from '../components/minimal/MinimalProducts.astro'
import MinimalOpenSource from '../components/minimal/MinimalOpenSource.astro'
import MinimalProjects from '../components/minimal/MinimalProjects.astro'
import MinimalClientWorks from '../components/minimal/MinimalClientWorks.astro'
import MinimalFigmaDesign from '../components/minimal/MinimalFigmaDesign.astro'
import MinimalCreativeCoding from '../components/minimal/MinimalCreativeCoding.astro'
import MinimalVisuals from '../components/minimal/MinimalVisuals.astro'
import MinimalVibeCoding from '../components/minimal/MinimalVibeCoding.astro'
import MinimalJustForFun from '../components/minimal/MinimalJustForFun.astro'
import MinimalLetsTalk from '../components/minimal/MinimalLetsTalk.astro'
import MinimalContact from '../components/minimal/MinimalContact.astro'
import SiteFooter from '../components/SiteFooter.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import Decorations from '../components/Decorations.astro'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e12" media="(prefers-color-scheme: dark)" />
    <meta
      name="description"
      content="Atishay Tuli is a creative frontend developer and a designer who develops. Specializing in GSAP, React, and immersive web experiences."
    />
    <meta
      name="keywords"
      content="atishay, Atishay Tuli, atishaytuli07, frontend developer, creative developer, creative frontend developer, UI engineer, GSAP developer, Framer Motion developer, React developer, Next.js developer, landing page developer, web animation, animated landing page, designer who codes"
    />
    <meta name="author" content="Atishay Tuli" />
    <meta name="robots" content="index, follow" />
    <meta
      property="og:title"
      content="Atishay Tuli · Creative Frontend Developer"
    />
    <meta
      property="og:description"
      content="Creative frontend developer who designs, builds, and animates web experiences. React · Next.js · GSAP · Framer Motion."
    />
    <meta
      property="og:image"
      content="https://www.creativeatishay.in/images/og-image.png"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Atishay Tuli, Creative Frontend Developer"
    />
    <meta property="og:url" content="https://www.creativeatishay.in" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Atishay Tuli · Creative Frontend Developer"
    />
    <meta
      name="twitter:description"
      content="Explore Atishay Tuli's webfolio featuring creative tools, GSAP animations, and immersive web experiences."
    />
    <meta
      name="twitter:image"
      content="https://www.creativeatishay.in/images/og-image.png"
    />
    <title>Atishay Tuli · Creative Frontend Developer &amp; Designer</title>
    <link rel="canonical" href="https://www.creativeatishay.in" />
    <link rel="icon" href="/assets/images/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/images/favicon.png" />
    <link rel="stylesheet" href="/assets/styles/style.css" />
    <link rel="stylesheet" href="/assets/styles/fonts.css" />
    <link rel="stylesheet" href="/assets/styles/app.css" />

    <!-- LCP element: the avatar is a CSS background-image, so the browser can't
         discover it until app.css parses. Preload it high-priority so it starts
         with the document -> the largest paint lands far sooner. -->
    <link rel="preload" as="image" href="/assets/images/01.webp" fetchpriority="high" />
    <!-- Signature type system: Hanken Grotesk (body), Bricolage Grotesque
         (display), JetBrains Mono (metrics). Self-hosted (latin subset) so the
         fonts are on our own origin instead of the third-party critical path.
         Preload the two the above-the-fold text needs so they start with the
         document, not after the CSS parses. -->
    <link rel="preload" href="/assets/fonts/hanken-grotesk-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/bricolage-grotesque-400_800.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Overrides: only the few things specific to this site (avatar image,
         making static project items visible since there is no JS animation). -->

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "mainEntity": {
          "@type": "Person",
          "name": "Atishay Tuli",
          "alternateName": ["atishay", "atishaytuli", "atishaytuli07"],
          "jobTitle": "Creative Frontend Developer",
          "url": "https://www.creativeatishay.in",
          "sameAs": [
            "https://github.com/atishaytuli07",
            "https://www.linkedin.com/in/atishaytuli07/",
            "https://twitter.com/atishaytuli07",
            "https://dribbble.com/atishaytuli07",
            "https://www.behance.net/atishaytuli07"
          ],
          "description": "Atishay Tuli is a creative frontend developer and a designer who develops. Specializing in GSAP, Framer Motion, React, and immersive web experiences.",
          "image": "https://www.creativeatishay.in/images/01.webp",
          "knowsAbout": [
            "Frontend Development",
            "Creative Development",
            "GSAP",
            "Framer Motion",
            "React",
            "Next.js",
            "Tailwind CSS",
            "Web Animation",
            "Landing Page Development",
            "UI Design",
            "Figma",
            "On-Page SEO"
          ]
        }
      }
    </script>
  </head>

  <body class="site-body">
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="page-shell">
      <!-- Mode toggle -->
      <ModeToggle />
      <!-- Creative mode (shown only when toggled) -->
      <div class="creative-only">
        <CreativeHero />
        <CreativeFolders />
        <CreativeReceipts />
      </div>
      <MinimalIntro />
      <MinimalProducts />
      <MinimalOpenSource />
      <MinimalProjects />
      <MinimalClientWorks />
      <MinimalFigmaDesign />
      <MinimalCreativeCoding />
      <MinimalVisuals />
      <MinimalVibeCoding />
      <MinimalJustForFun />
      <MinimalLetsTalk />
      <MinimalContact />
      <!-- Footer with live clock -->
      <footer class="site-footer">
        <div>
          <p>
            <span id="clock" class="clock">
              <span data-h>00</span><span class="clock-colon">:</span
              ><span data-m>00</span><span class="clock-colon">:</span
              ><span data-s>00</span> <span data-ampm>AM</span> · India
            </span>
          </p>
        </div>
      </footer>
    </div>

    <Decorations />
    <ThemeToggle />
    <script src="/assets/scripts/lenis.min.js" defer></script>
    <script src="/assets/scripts/script.js" defer></script>
  </body>
</html>
