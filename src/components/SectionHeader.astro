---
interface Props {
  tag: string
  title: string
  align?: 'left' | 'center'
}

const { tag, title, align = 'center' } = Astro.props
---

<div class:list={['section-header', `align-${align}`]}>
  <span class="section-tag">{tag}</span>
  <h2 class="section-title">{title}</h2>
  <div class="section-divider"></div>
</div>
