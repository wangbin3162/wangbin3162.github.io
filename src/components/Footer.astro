---
import { Image } from 'astro:assets'
import beianIcon from '../assets/site/beian.png'
import { filingInfo } from '../data/profile'

const today = new Date()
---

<footer>
  <div class="footer-inner">
    <div class="footer-records">
      <a href={filingInfo.icpHref} target="_blank" rel="noreferrer">{filingInfo.icpLabel}</a>
      <a class="footer-gongan" href={filingInfo.gonganHref} target="_blank" rel="noreferrer">
        <Image src={beianIcon} alt="" widths={[32]} sizes="16px" />
        <span>{filingInfo.gonganLabel}</span>
      </a>
    </div>
    <p class="footer-copy">&copy; {today.getFullYear()} 彬的编程实验室</p>
  </div>
</footer>

<style>
  footer {
    padding: var(--space-md) var(--space-sm);
    border-top: 1px solid var(--border);
  }
  .footer-inner {
    width: min(var(--container-max), calc(100% - 48px));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
  .footer-records {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }
  .footer-records a,
  .footer-copy {
    color: var(--text-muted);
    font-size: var(--text-small);
    text-decoration: none;
    transition: color 0.2s var(--ease-in-out);
  }
  .footer-records a:hover {
    color: var(--accent);
  }
  .footer-gongan {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .footer-gongan :global(img) {
    width: 0.95rem;
    height: 1rem;
  }
  @media (max-width: 640px) {
    .footer-inner {
      width: calc(100% - 24px);
      flex-direction: column;
      gap: var(--space-xs);
      text-align: center;
    }
    .footer-records {
      justify-content: center;
      gap: var(--space-sm);
    }
  }
</style>
