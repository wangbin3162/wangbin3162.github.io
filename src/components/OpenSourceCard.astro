---
import { Image } from 'astro:assets'
import type { OpenSourceItem } from '../data/opensource'

interface Props {
  item: OpenSourceItem
}

const { item } = Astro.props
---

<article class="oss-card glass-card">
  <div class="oss-card-image">
    <Image src={item.image} alt={item.name} widths={[640]} sizes="(max-width: 768px) 100vw, 33vw" />
  </div>
  <div class="oss-card-body">
    <div class="oss-card-head">
      <div>
        <p class="oss-card-name">{item.icon} {item.name}</p>
        <p class="oss-card-desc">{item.description}</p>
      </div>
      <span class="oss-card-stars">⭐ {item.stars}</span>
    </div>
    <div class="oss-card-tags">
      {item.techs.map((tech) => <span class="tech-chip">{tech}</span>)}
    </div>
    <div class="oss-card-links">
      <a href={item.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href={item.demo} target="_blank" rel="noreferrer">Demo</a>
    </div>
  </div>
</article>
<style>
  .oss-card {
    overflow: hidden;
  }
  .oss-card-image {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.08), rgba(168, 85, 247, 0.12));
  }
  .oss-card-image :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .oss-card-body {
    padding: 1.2rem;
  }
  .oss-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .oss-card-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
  }
  .oss-card-desc {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: 0.94rem;
  }
  .oss-card-stars {
    flex: none;
    color: var(--accent-strong);
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 700;
  }
  .oss-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }
  .oss-card-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .oss-card-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 88px;
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    background: var(--accent-light);
    color: var(--accent-strong);
    font-weight: 700;
  }
</style>
